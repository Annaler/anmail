set -euo pipefail


# Tips
usage(){
    cat <<'EOF'
pls: anmail <command> [option]

Commands:
    send <To> [Subject]    compose & send an email via himalaya
    list                   list mails via himalaya 
    read <ID>              read mails via himalaya 
    set [tag] [from]      set or list accounts
    use [tag]          switch default account to use

Global options:
    -t, --tag <tag>        provisonally using account tagged as <tag> in ANMAIL_CONFIG
    -h, --help             get some info

Options:
    -v, --version          get version of anmail

Environment:
    ANMAIL_CONFIG          path to accounts file (default: ~/.config/anmail/accounts.config)
    VISUAL                 editor (takes precedence, default: EDITOR)
    EDITOR                 editor to compose the body of a mail(default: nvim)

Requires:
    bash        needed version 3.0+
    himalaya    https://github.com/pimalaya/himalaya
    nvim (or editor)    https://neovim.io

Run 'anmail <command> --help' for sub-help of command.
EOF
}
brief(){
    cat <<'EOF'
anmail: A thin wrapper around himalaya.
        Dev-ed for fun, for my convenience, by Annaler.
Try 'anmail --help'
EOF
}
version(){
    cat <<'EOF'
anmail version 0.3.3 (2026-10-12)
repo: https://github.com/Annaler/anmail
EOF
}
usage_set(){
    cat <<'EOF'
anmail set [options] [tag] [from]

Manage accounts in the accounts file.
The <tag>, should be same as <tag> in  [accounts.<tag>] (himalaya's config in ~/.config/himalaya/config.toml)

Forms:
    anmail set (list)              list accounts
    anmail set <tag> <from>       set or overwrite an account
    anmail set -i [tag] [from]    interactive mode

Accounts file format:
    <tag>=<from>
    Tag="Display Name" <you@example.com>
    work="Work Name" <work@company.com>

File location:
    $ANMAIL_CONFIG, or '~/.config/anmail/accounts.config' by default.

Examples:
    anmail set work '"Work Name" <work@company.com>'
    anmail set -i
    anmail set -i personal
EOF
}
usage_send(){
    cat <<'EOF'
anmail send <To> [Subject]

compose a mail in $EDITOR and send it via himalaya.

Arguments:
    <To>             recipient address
    [Subject]        optional subject

Environment:
    VISUAL           editor (takes precedence, default: EDITOR)
    EDITOR           editor to compose the body (default: nvim)

    Must be a single executable path, arguments are not supported.
    Vim series get 'set ft=mail' for mail syntax highlighting.

Requires:
    an account (see 'anmail set --help')
EOF
}
usage_use(){
    cat <<'EOF'
anmail use [account]

switch the default used when '-t / --tag' is not given.

Forms:
    anmail use             show current account
    anmail use <tag>       switch to account tagged as <tag>

Behavior:
    Without -t, anmail use the account named by 'current=' in the
    accounts file. If no 'current=' line exist, the first account
    in the file will be.

The 'current' name is reserved and can't be set with 'anmail set'.
EOF
}

# Tmp: mk, clean
TMP_FILES=()
clean_up(){
    local file
   #for file in "${TMP_FILES[@]}"; do 
    for file in "${TMP_FILES[@]+"${TMP_FILES[@]}"}"; do
    # then bash <4.4 also can run
        [[ -n "$file" ]] && rm -f "$file"
    done
}
trap clean_up EXIT
new_tmp(){
    local var="$1"
    local file
    file="$(mktemp)"
    TMP_FILES+=("$file")
    printf -v "$var" '%s' "$file"
}

# Accounts
accounts_file_path(){
    printf '%s' "${ANMAIL_CONFIG:-$HOME/.config/anmail/accounts.config}"
}

CURRENT_ACCOUNT="" #[using] current
ACCOUNTS_TAGS=() #[accounts] 'tag'=
declare -A ACCOUNTS_MAP=()

#parse to reuse
parse_accounts_file(){
    local need_current=0 need_accounts=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            current) need_current=1; shift ;;
            accounts) need_accounts=1; shift;;
            all)     need_current=1; need_accounts=1; shift ;;
            *) echo "unknown args: '$1'"; shift ;;
        esac
    done
    
    local config
    config="$(accounts_file_path)"

    #paese
    local line tag from section=""
    local cleared_current=0 cleared_accounts=0
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue
        # section
        if [[ "$line" =~ ^\[(.+)\]$ ]]; then
            section="${BASH_REMATCH[1]}"
            continue
        fi
        [[ "$line" == *=* ]] || continue

        case "$section" in
            using)#[using]
                [[ "$need_current" -ne 1 ]] && continue
                [[ "$cleared_current" -eq 0 ]] && { CURRENT_ACCOUNT=""; cleared_current=1; }
                tag="${line%%=*}"
                [[ "$tag" == "current" ]] && CURRENT_ACCOUNT="${line#*=}"
                ;;
            accounts)#[accounts]
                [[ "$need_accounts" -ne 1 ]] && continue
                [[ "$cleared_accounts" -eq 0 ]] && { ACCOUNTS_TAGS=(); ACCOUNTS_MAP=(); cleared_accounts=1; }
                tag="${line%%=*}"
                from="${line#*=}"
                [[ -z "${ACCOUNTS_MAP[$tag]:-}" ]] && ACCOUNTS_TAGS+=("$tag")
                ACCOUNTS_MAP["$tag"]="$from"
                ;;
        esac
    done < "$config"

}

load_account_from(){
    local account="$1"
    local config
    config="$(accounts_file_path)"

    [[ -f "$config" ]] || return 1

    parse_accounts_file accounts

    local from
    from="${ACCOUNTS_MAP[$account]:-}"
    [[ -n "$from" ]] || return 1
    printf '%s' "$from"
}
resolve_account(){
    local config
    config="$(accounts_file_path)"

    # -t
    if [[ -n "$TAG" ]]; then
        printf '%s' "$TAG"
        return 0
    fi
    [[ -f "$config" ]] || return 1

    parse_accounts_file current
    if [[ -n "$CURRENT_ACCOUNT" ]]; then
        printf '%s' "$CURRENT_ACCOUNT"
        return 0
    fi

    parse_accounts_file accounts
    if [[ ${#ACCOUNTS_TAGS[@]} -gt 0 ]]; then
        printf '%s' "${ACCOUNTS_TAGS[0]}"
        return 0
    fi

    return 1
}

read_accounts_config(){
    local config
    config="$(accounts_file_path)"

    [[ -f "$config" ]] || return 0
    
    parse_accounts_file current accounts
}
write_accounts_config(){
    local config tmp
    config="$(accounts_file_path)"
    new_tmp tmp
    mkdir -p "$(dirname "$config")"
    
    {
        printf '[using]\n'
        printf 'current=%s\n' "${CURRENT_ACCOUNT:-}"
        printf '[accounts]\n'
        local tag
        for tag in "${ACCOUNTS_TAGS[@]}"; do
            local from
            from="${ACCOUNTS_MAP[$tag]}"
            printf '%s=%s\n' "$tag" "$from"
        done
    } > "$tmp"
    mv "$tmp" "$config"
}


# Function
#send
cmd_send(){
    #help
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage_send
        return
    fi

    #header
    if [[ $# -eq 0 ]]; then
        echo "pls: mail send <To> ([Subject])" >&2
        exit 1
    fi
    local TO="$1"
    local SUBJECT="${2:-}"

    new_tmp BODY

    #nvim(or user's EDITOR) body
    if [[ -z "${VISUAL:-}" && -z "${EDITOR}" ]]; then
        echo "anmail: no EDITOR set, using nvim." >&2
    fi
        #just using any editor u want
    local editor="${VISUAL:-${EDITOR:-nvim}}"
    local editor_name
    editor_name="$(basename "$editor")"
    local -a editor_args=()
    case "$editor_name" in
        vim|nvim|gvim|mvim)
            editor_args+=(-c 'set ft=mail')
            ;;
    esac
    "$editor" "${editor_args[@]}" "$BODY"

    #check text
    if ! grep -q '[^[:space:]]' "$BODY"; then
        echo "why send empty" >&2
        exit 1
    fi

    #compose
    {
        printf 'From: %s\n' "$FROM"
        printf 'To: %s\n' "$TO"
        #Subject can be none
        if [[ -n "$SUBJECT" ]]; then
            printf 'Subject: %s\n' "$SUBJECT"
        fi
        printf '\n'
        cat "$BODY"
    } | himalaya message send --account "$TAG"
    
    rm -f "$BODY" # sometimes, trap will not work 
}

#list
cmd_list(){
    himalaya envelope list --account "$TAG" "$@"
}

#read
cmd_read(){
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        himalaya message read --help
        return
    fi
    if [[ $# -eq 0 ]] ; then
        echo "pls: tell me what u wanna read."
        echo "anmail: may using 'anmail read <ID>' or try 'anmail read --help"
        exit 1
    fi
    himalaya message read --account "$TAG" "$@"
}

#set
cmd_set(){
    local interactive=0
    local config
    config="$(accounts_file_path)"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                usage_set
                return
                ;;
            -i|--interactive)
                interactive=1
                shift
                ;;
            *)
                break
                ;;
        esac
    done

    #no args/interactive -> list
    if [[ "${1:-}" == "list" || ( $# -eq 0 && $interactive -eq 0 ) ]]; then
        if [[ -f "$config" ]]; then
            cat "$config"
        else
            echo "anmail: no account in $config" >&2
        fi
        return
    fi

    local tag from
    if [[ $interactive -eq 1 ]]; then
        if [[ $# -ge 1 ]]; then
            tag="$1"
        else
            read -rp "account tag: " tag
        fi
        if  [[ -z "$tag" ]]; then
            echo "pls: tell me the account tag." >&2
            exit 1
        fi
        if [[ $# -ge 2 ]]; then
            from="$2"
        else
            read -rp "from for '$tag': " from
        fi
    else
        if [[ $# -ne 2 ]]; then
            echo "anmail: usage: anmail set <tag> <from>" >&2
            echo "    e.g. anmail set work '\"Work Name\" <work@company.com>'" >&2
            echo "    or:  anmail set -i [tag] [from]" >&2
            exit 1
        fi
        tag="$1"
        from="$2"
    fi

    if [[ -z "$tag" ]]; then
        if [[ -z "$from" ]]; then
            echo "anmail: tag & from can't be empty." >&2
            exit 1
        else
            echo "pls: tell me the account tag." >&2
            exit 1 
        fi
    elif [[ -z "$from" ]]; then
        echo "anmail: from can't be empty" >&2
        exit 1
    fi
    if [[ "$tag" == "current" ]]; then
        echo "anmail: 'current' is reserved, use 'anmail use' instead" >&2
        exit 1
    fi

    read_accounts_config
    [[ -z "${ACCOUNTS_MAP[$tag]:-}" ]] && ACCOUNTS_TAGS+=("$tag")
    ACCOUNTS_MAP["$tag"]="$from"
    [[ -z "$CURRENT_ACCOUNT" ]] && CURRENT_ACCOUNT="$tag"
    write_accounts_config
    echo "anmail: account '$tag' set successfully."
}
cmd_use(){
    local config
    config="$(accounts_file_path)"

    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage_use
        return
    fi

    #no args, show current
    local current
    if [[ $# -eq 0 ]]; then
        if current="$(resolve_account)"; then
            echo "anmail: current account: $current"
        else
            echo "anmail: no accounts configured." >&2
            exit 1
        fi
        return
    fi

    local tag="$1"
    if [[ "$tag" == "current" ]]; then
        echo "anmail: 'current' is reserved." >&2
        if current="$(resolve_account)"; then
            echo "anmail: current account: $current"
        fi
        exit 1
    fi
    
    read_accounts_config
    if [[ -z "${ACCOUNTS_MAP[$tag]:-}" ]]; then
        echo "anmail: unknown account '$tag'" >&2
        echo "May: check $config" >&2
        exit 1
    fi
    CURRENT_ACCOUNT="$tag"
    write_accounts_config
    echo "anmail: now you're using '$tag'."
}

#mainu~
TAG=""
args=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -t|--tag)
            TAG="$2"
            shift 2
            ;;
        --tag=*)
            TAG="${1#*=}"
            shift
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

cmd="${args[0]:-}"
sub_args=("${args[@]:1}")

# some one, skip the check
case "$cmd" in
    set|use|-h|--help|-v|--version|"")
        :
        ;;
    send|list|read)
        case "${sub_args[0]:-}" in
            -h|--help)# let cmd_* handle sub-help
                : # skip, =~ pass
                ;;
            *)
                if [[ -z "$TAG" ]]; then
                    TAG="$(resolve_account)" || {
                        echo "anmail: no accounts configured." >&2
                        echo "May try: anmail set -i" >&2
                        exit 1
                    }
                fi
 
                FROM="$(load_account_from "$TAG")" || {
                    echo "anmail: unknown account '$TAG'" >&2
                    echo "May: Check $(accounts_file_path)" >&2
                    exit 1
                }
                ;;
        esac
        ;;
    *)
        echo "anmail: unknown command '$cmd'" >&2
        echo "May try: anmail --help" >&2
        exit 1
        ;;
esac

# cmd
case "$cmd" in
    send)
        cmd_send "${sub_args[@]}"
        ;;
    list)
        cmd_list "${sub_args[@]}"
        ;;
    read)
        cmd_read "${sub_args[@]}"
        ;;
    set)#'|conf|config)'?
        cmd_set "${sub_args[@]}"
        ;;
    use)
        cmd_use "${sub_args[@]}"
        ;;
    -h|--help)
        usage
        ;;
    -v|--version)
        version
        ;;
    "")
        brief
        exit 1
        ;;
    *)
        echo "anmail: unknown command '$cmd'" >&2
        echo "May try: anmail help" >&2
        exit 1
        ;;
esac
