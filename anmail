set -euo pipefail


# Tips
usage(){
    cat <<'EOF'
pls: anmail <command> [option]

Commands:
    send <To> [Subject]    compose & send an email via himalaya
    list [options]         list mails via himalaya 
    read <ID> [options]    read mails via himalaya 
    show                   list accounts
    use [tag]          switch default account to use

Global options:
    -t, --tag <tag>        provisonally use account tagged as <tag>
    -h, --help             get some info

Options:
    -v, --version          get version of anmail

Environment:
    VISUAL                 editor (takes precedence, default: EDITOR)
    EDITOR                 editor to compose the body of a mail(default: nvim)
    HIMALAYA_CONFIG        override path to himalaya config (for testing)

Requires:
    bash        needed version 3.0+
    himalaya    https://github.com/pimalaya/himalaya
    nvim (or editor)    https://neovim.io

Run 'anmail <command> --help' for sub-help of command.
EOF
}
brief(){
    cat <<'EOF'
anmail: A thin wrapper around himalaya.
        Dev-ed for fun, for my convenience, by Annaler.
Try 'anmail --help'
EOF
}
version(){
    cat <<'EOF'
anmail version 0.3.4 (2026-11-01)
repo: https://github.com/Annaler/anmail
EOF
}
usage_show(){
    cat <<'EOF'
anmail show

List accounts configured in himalaya.

Reads from: ~/.config/himalaya/config.toml (or $HIMALAYA_CONFIG)
The '*' marks the tag selected by 'anmail use'.

Add or edit accounts in himalaya's config. anmail never writes that file.
EOF
}
usage_send(){
    cat <<'EOF'
anmail send <To> [Subject]

compose a mail in $EDITOR and send it via himalaya.

Arguments:
    <To>             recipient address
    [Subject]        optional subject

Environment:
    VISUAL           editor (takes precedence, default: EDITOR)
    EDITOR           editor to compose the body (default: nvim)

    Must be a single executable path, arguments are not supported.
    Vim series get 'set ft=mail' for mail syntax highlighting.

Account:
    -t / --tag <tag> picks the account.
    Otherwise the tag selected by 'anmail use' is used.
    Otherwise himalaya's own default is used.
EOF
}
usage_use(){
    cat <<'EOF'
anmail use [account]

Show or switch the account used when '-t / --tag' is not given.

Forms:
    anmail use             show current account
    anmail use <tag>       select account tagged as <tag>

Behavior:
    The selected tag is stored in
        ${XDG_STATE_HOME:-~/.local/state}/anmail/current
    It only affects anmail; himalaya's config is untouched.

    If no account is selected, anmail falls back to the first account
    in himalaya's config (or lets himalaya use its own default).
EOF
}

# Tmp: mk, clean
TMP_FILES=()
clean_up(){
    local file
   #for file in "${TMP_FILES[@]}"; do 
    for file in "${TMP_FILES[@]+"${TMP_FILES[@]}"}"; do
    # then bash <4.4 also can run
        [[ -n "$file" ]] && rm -f "$file"
    done
}
trap clean_up EXIT
new_tmp(){
    local var="$1"
    local file
    file="$(mktemp)"
    TMP_FILES+=("$file")
    printf -v "$var" '%s' "$file"
}

# Accounts
himalaya_config_path(){
    local path
    for path in \
        "${HIMALAYA_CONFIG:-}" \
        "${XDG_CONFIG_HOME:-$HOME/.config}/himalaya/config.toml" \
        "$HOME/.config/himalaya/config.toml" \
        "$HOME/.himalayarc"
    do
        [[ -n "$path" && -f "$path" ]] && { printf '%s' "$path"; return 0; }
    done
    return 1
}
parse_header(){
    local line="$1"
    line="${line%%#*}"
    [[ "$line" =~ ^[[:space:]]*\[[[:space:]]*accounts[[:space:]]*\.(.*)\][[:space:]]*$ ]] || return 1

    local sss="${BASH_REMATCH[1]}"
    sss="${sss#"${sss%%[![:space:]]*}"}"
    sss="${sss%"${sss##*[![:space:]]}"}"

    if [[ "$sss" =~ ^\"([^\"]*)\"$ ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
    elif [[ "$sss" =~ ^[A-Za-z0-9_-]+$ ]]; then
        printf '%s' "$sss"
    else
        return 1
    fi
}
himalaya_accounts_header_from(){
    local tmpname="$1"
    local config
    config="$(himalaya_config_path)" || return 1

    local line email="" name="" in_account=0 tag
    while IFS= read -r line; do
        [[ -z "${line// }" || "$line" =~ ^[[:space:]]*# ]] && continue

        if tag="$(parse_header "$line")"; then
            [[ "$in_account" -eq 1 ]] && break
            [[ "$tag" == "$tmpname" ]] && in_account=1
            continue
        fi

        [[ "$line" =~ ^[[:space:]]*\[ ]] && { [[ "$in_account" -eq 1 ]] && break; continue; }

        [[ "$in_account" -eq 1 ]] || continue

        if [[ "$line" =~ ^[[:space:]]*(email|from)[[:space:]]*=[[:space:]]*\"(.*)\"[[:space:]]*$ ]]; then
            email="${BASH_REMATCH[2]}"
        elif [[ "$line" =~ ^[[:space:]]*(display-name|from-name)[[:space:]]*=[[:space:]]*\"(.*)\"[[:space:]]*$ ]]; then
            name="${BASH_REMATCH[2]}"
        fi
    done < "$config"

    [[ -n "$email" ]] || return 1

    if [[ -n "$name" ]]; then
        printf '%s <%s>' "$name" "$email"
    else
        printf '%s' "$email"
    fi
}
account_exists(){
    himalaya_accounts_header_from "$1" >/dev/null 2>&1
}
himalaya_account_tags(){
    local config
    config="$(himalaya_config_path)" || return 1

    local line tag rc
    while IFS= read -r line; do
        if tag="$(parse_header "$line")"; then
            printf '%s\n' "$tag"
        fi
    done < "$config"
}
state_file(){
    printf '%s' "${XDG_STATE_HOME:-$HOME/.local/state}/anmail/current"
}
state_read(){
    local file tag
    file="$(state_file)"
    [[ -f "$file" ]] || return 1
    IFS= read -r tag < "$file" || true
    [[ -n "$tag" ]] && printf '%s' "$tag"
}
state_write(){
    local file
    file="$(state_file)"
    mkdir -p "$(dirname "$file")"
    printf '%s\n' "$1" > "$file"
}
resolve_account(){
    local current first
    if current="$(state_read)"; then
        printf '%s' "$current"; return 0
    fi
    first="$(himalaya_account_tags | head -n1)" || true
    [[ -n "$first" ]] && { printf '%s' "$first"; return 0; }
    return 1
}

# Function
#send
cmd_send(){
    #help
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage_send
        return
    fi

    #header
    if [[ $# -eq 0 ]]; then
        echo "pls: mail send <To> ([Subject])" >&2
        exit 1
    fi
    local TO="$1"
    local SUBJECT="${2:-}"

    new_tmp BODY

    #nvim(or user's EDITOR) body
    if [[ -z "${VISUAL:-}" && -z "${EDITOR}" ]]; then
        echo "anmail: no EDITOR set, using nvim." >&2
    fi
        #just using any editor u want
    local editor="${VISUAL:-${EDITOR:-nvim}}"
    local editor_name
    editor_name="$(basename "$editor")"
    local -a editor_args=()
    case "$editor_name" in
        vim|nvim|gvim|mvim)
            editor_args+=(-c 'set ft=mail')
            ;;
    esac
    "$editor" "${editor_args[@]}" "$BODY"

    #check text
    if ! grep -q '[^[:space:]]' "$BODY"; then
        echo "why send empty" >&2
        exit 1
    fi

    #compose
    {
        printf 'From: %s\n' "$FROM"
        printf 'To: %s\n' "$TO"
        #Subject can be none
        if [[ -n "$SUBJECT" ]]; then
            printf 'Subject: %s\n' "$SUBJECT"
        fi
        printf '\n'
        cat "$BODY"
    } | himalaya ${TAG:+--account "$TAG"} message send
    
    rm -f "$BODY" # sometimes, trap will not work 
}

#list
cmd_list(){
    himalaya ${TAG:+--account "$TAG"} envelope list "$@" 
}

#read
cmd_read(){
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        himalaya ${TAG:+--account "$TAG"} message read --help
        return
    fi
    if [[ $# -eq 0 ]] ; then
        echo "pls: tell me what u wanna read."
        echo "anmail: may using 'anmail read <ID>' or try 'anmail read --help"
        exit 1
    fi
    himalaya ${TAG:+--account "$TAG"} message read "$@"
}

#show
cmd_show(){
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage_show
        return
    fi

    local config
    if ! config="$(himalaya_config_path)"; then
        echo "anmail: can't find himalaya config." >&2
        echo "  looked for: ${XDG_CONFIG_HOME:-$HOME/.config}/himalaya/config.toml" >&2
        exit 1
    fi

    local current from tag mark
    current="$(state_read 2>/dev/null || true)"

    printf '%-16s %s\n' "TAG" "FROM"
    while IFS= read -r tag; do
        from="$(himalaya_accounts_header_from "$tag" 2>/dev/null || echo "(no email)")"
        mark=" "
        [[ "$tag" == "$current" ]] && mark="*"
        printf '%s %-14s %s\n' "$mark" "$tag" "$from"
    done < <(himalaya_account_tags)
}
cmd_use(){
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage_use
        return
    fi

    #no args, show current
    local current
    if [[ $# -eq 0 ]]; then
        if current="$(state_read)"; then
            echo "anmail: current account: $current"
        else
            echo "anmail: no account selected (himalaya default will be used)."
        fi
        return
    fi

    local tag="$1"
    if ! account_exists "$tag"; then
        echo "anmail: unknown account '$tag'" >&2
        echo "May try: anmail show" >&2
        exit 1
    fi
    state_write "$tag"
    echo "anmail: now you're using '$tag'."
}

#mainu~
TAG=""
args=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -t|--tag)
            TAG="$2"
            shift 2
            ;;
        --tag=*)
            TAG="${1#*=}"
            shift
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

cmd="${args[0]:-}"
sub_args=("${args[@]:1}")

# some one, skip the check
case "$cmd" in
    show|use|-h|--help|-v|--version|"")
        :
        ;;
    send|list|read)
        case "${sub_args[0]:-}" in
            -h|--help)# let cmd_* handle sub-help
                : # skip, =~ pass
                ;;
            *)
                if [[ -z "$TAG" ]]; then
                    TAG="$(resolve_account)" || {
                        echo "anmail: no accounts found in himalaya config." >&2
                        echo "May check: ~/.config/himalaya/config.toml" >&2
                        exit 1
                    }
                fi
 
                FROM="$(himalaya_accounts_header_from "$TAG")" || {
                    echo "anmail: account '$TAG' has no email in config." >&2
                    echo "May: Check $(himalaya_config_path)" >&2
                    exit 1
                }
                ;;
        esac
        ;;
    *)
        echo "anmail: unknown command '$cmd'" >&2
        echo "May try: anmail --help" >&2
        exit 1
        ;;
esac

# cmd
case "$cmd" in
    send)
        cmd_send "${sub_args[@]}"
        ;;
    list)
        cmd_list "${sub_args[@]}"
        ;;
    read)
        cmd_read "${sub_args[@]}"
        ;;
    show)#'|conf|config)'?
        cmd_show "${sub_args[@]}"
        ;;
    use)
        cmd_use "${sub_args[@]}"
        ;;
    -h|--help)
        usage
        ;;
    -v|--version)
        version
        ;;
    "")
        brief
        exit 1
        ;;
    *)
        echo "anmail: unknown command '$cmd'" >&2
        echo "May try: anmail help" >&2
        exit 1
        ;;
esac
