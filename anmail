set -euo pipefail

#tip
usage(){
    cat <<'EOF'
pls: anmail <command> [option]

Commands:
    send <To> [Subject]    compose&send an email via himalaya
    list [options]...      list mails via himalaya 
    read <ID> [options]... read mails via himalaya 

Options:
    -h, --help, help       get some info
    -v, --version          get version of anmail

Enviroment:
    MAIL_FROM sender here pls, e.g. "anmal" <4nma1@example.com>
              export MAIL_FROM='"anmal" <4nmai1@example.com>'
    EDITOR    Editor to compose the body of a mail (default: nvim)

Requires:
    himalaya    https://github.com/pimalaya/himalaya
    nvim (or EDITOR)    https://neovim.io
EOF
}
brief(){
    cat <<'EOF'
anmail: A thin wrapper around himalaya.
        Dev-ed for fun, for my convenience, by Annaler.
Try 'anmail help'
EOF
}
version(){
    cat <<'EOF'
anmail version 0.2.0 (2026-10-10)
repo: https://github.com/Annaler/anmail
EOF
}


#tmp: mk, clean
TMP_FILES=()
clean_up(){
    local file
  #for file in "${TMP_FILES[@]}"; do 
    for file in "${TMP_FILES[@]+"${TMP_FILES[@]}"}"; do
    # then bash <4.4 also can run
        [[ -n "$file" ]] && rm -f "$file"
    done
}
trap clean_up EXIT
new_tmp(){
    local var="$1"
    local file
    file="$(mktemp)"
    TMP_FILES+=("$file")
    printf -v "$var" '%s' "$file"
}


# Function

#send
cmd_send(){
    #header
    if [[ $# -eq 0 ]]; then
        echo "pls: mail send <To> ([Subject])"
        exit 1
    fi
    local TO="$1"
    local SUBJECT="${2:-}"

    new_tmp BODY

    #nvim(or user's EDITOR) body
    local editor="${EDITOR:-nvim}"
    [[ -z "${EDITOR:-}" ]] && echo "anmail: EDITOR not set, using nvim." >&2
    "$editor" -c 'set ft=mail' "$BODY"

    #check text
    if ! grep -q '[^[:space:]]' "$BODY"; then
        echo "why send empty" >&2
        exit 1
    fi

    if [[ -z "${MAIL_FROM:-}" ]]; then
        echo "anmail: pls set '\$MAIL_FROM'." 
        echo "May try: export MAIL_FROM='\"Display Name\" <email@example.com>'" >&2
        exit 1
    fi
    local FROM="$MAIL_FROM"
    
    #compose
    {
        printf 'From: %s\n' "$FROM"
        printf 'To: %s\n' "$TO"
        #Subject can be none
        if [[ -n "$SUBJECT" ]]; then
            printf 'Subject: %s\n' "$SUBJECT"
        fi
        printf '\n'
        cat "$BODY"
    } | himalaya message send
    
    rm -f "$BODY"
}

#list
cmd_list(){
    himalaya envelope list "$@"
}

#read
cmd_read(){
    if [[ $# -eq 0 ]] ; then
        echo "pls: tell me what u wanna read."
        echo "anmail: may using 'anmail read <ID>' or try 'anmail read --help"
        exit 1
    fi
    himalaya message read "$@"
}

#mainu~
cmd="${1:-}"

shift || true

case "$cmd" in
    send)
        cmd_send "$@"
        ;;
    list)
        cmd_list "$@"
        ;;
    read)
        cmd_read "$@"
        ;;
    -h|--help|help)
        usage
        ;;
    -v|--version)
        version
        ;;
    "")
        brief
        exit 1
        ;;
    *)
        echo "anmail: Unknown command '$cmd'" >&2
        echo "May try 'anmail help'" >&2
        exit 1
        ;;
esac
