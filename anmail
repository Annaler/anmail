set -euo pipefail


# Tips
usage(){
    cat <<'EOF'
pls: anmail <command> [option]

Commands:
    send <To> [Subject]    compose & send an email via himalaya
    list                   list mails via himalaya 
    read <ID>              read mails via himalaya 
    set [name] [from]      set or list accounts
    use [account]          switch default account to use

Global options:
    -a, --account <name>   provisonally using account in ANMAIL_CONFIG
    -h, --help             get some info

Options:
    -v, --version          get version of anmail

Environment:
    ANMAIL_CONFIG          path to accounts file (default: ~/.config/anmail/accounts.config)
    VISUAL                 editor (takes precedence, default: EDITOR)
    EDITOR                 editor to compose the body of a mail(default: nvim)

Requires:
    himalaya    https://github.com/pimalaya/himalaya
    nvim (or EDITOR)    https://neovim.io

Run 'anmail <command> --help' for sub-help of command.
EOF
}
brief(){
    cat <<'EOF'
anmail: A thin wrapper around himalaya.
        Dev-ed for fun, for my convenience, by Annaler.
Try 'anmail --help'
EOF
}
version(){
    cat <<'EOF'
anmail version 0.3.1 (2026-10-11)
repo: https://github.com/Annaler/anmail
EOF
}
usage_set(){
    cat <<'EOF'
anmail set [options] [name] [from]

Manage accounts in the accounts file.

Forms:
    anmail set (list)              list accounts
    anmail set <name> <from>       set or overwrite an account
    anmail set -i [name] [from]    interactive mode

Accounts file format:
    <name>=<from>
    tag="Display Name" <you@example.com>
    work="Work Name" <work@company.com>

File location:
    $ANMAIL_CONFIG, or '~/.config/anmail/accounts.config' by default.

Examples:
    anmail set work '"Work Name" <work@company.com>'
    anmail set -i
    anmail set -i personal
EOF
}
usage_send(){
    cat <<'EOF'
anmail send <To> [Subject]

compose a mail in $EDITOR and send it via himalaya.

Arguments:
    <To>             recipient address
    [Subject]        optional subject

Environment:
    VISUAL           editor (takes precedence, default: EDITOR)
    EDITOR           editor to compose the body (default: nvim)

    Must be a single executable path, arguments are not supported.
    Vim series get 'set ft=mail' for mail syntax highlighting.

Requires:
    an account (see 'anmail set --help')
EOF
}
usage_use(){
    cat <<'EOF'
anmail use [account]

switch the default used when '-a / --account' is not given.

Forms:
    anmail use             show current account
    anmail use <account>   switch to account <account>

Behavior:
    Without -a, anmail use the account named by 'current=' in the
    accounts file. If no 'current=' line exist, the first account
    in the file will be.

The 'current' name is reserved and can't be set with 'anmail set'.
EOF
}

# Tmp: mk, clean
TMP_FILES=()
clean_up(){
    local file
   #for file in "${TMP_FILES[@]}"; do 
    for file in "${TMP_FILES[@]+"${TMP_FILES[@]}"}"; do
    # then bash <4.4 also can run
        [[ -n "$file" ]] && rm -f "$file"
    done
}
trap clean_up EXIT
new_tmp(){
    local var="$1"
    local file
    file="$(mktemp)"
    TMP_FILES+=("$file")
    printf -v "$var" '%s' "$file"
}

# Accounts
accounts_file_path(){
    printf '%s' "${ANMAIL_CONFIG:-$HOME/.config/anmail/accounts.config}"
}
load_account_from(){
    local account="$1"
    local config
    config="$(accounts_file_path)"

    [[ -f "$config" ]] || return 1

    local line name from
    local section=""
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue
        # section
        if [[ "$line" =~ ^\[(.+)\]$ ]]; then
            section="${BASH_REMATCH[1]}"
            continue
        fi

        # only read waht is in [accounts]
        [[ "$section" == "accounts" ]] || continue

        name="${line%%=*}"
        from="${line#*=}"
        if [[ "$name" == "$account" ]]; then
            printf '%s' "$from"
            return 0
        fi
    done < "$config"
    return 1
}
resolve_account(){
    local config
    config="$(accounts_file_path)"

    # -a
    if [[ -n "$ACCOUNT" ]]; then
        printf '%s' "$ACCOUNT"
        return 0
    fi
    [[ -f "$config" ]] || return 1

    local line name
    local section=""
    local using=""
    local first_account=""

    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue

        if [[ "$line" =~ ^\[(.+)\]$ ]]; then
            section="${BASH_REMATCH[1]}"
            continue
        fi

        case "$section" in
            using)#[using]
                name="${line%%=*}"
                if [[ "$name" == "current" ]]; then
                    using="${line#*=}"
                fi
                ;;
            accounts)#[accounts]
                name="${line%%=*}"
                [[ -z "$first_account" ]] && first_account="$name"
                ;;
        esac
    done < "$config"

    if [[ -n "$using" ]]; then
        printf '%s' "$using"
        return 0
    fi

    if [[ -n "$first_account" ]]; then
        printf '%s' "$first_account"
        return 0
    fi

    return 1
}

CURRENT_ACCOUNT="" #[using] current
ACCOUNTS_NAMES=() #[accounts] 'name'=
declare -A ACCOUNTS_MAP=()
read_accounts_config(){
    local config
    config="$(accounts_file_path)"
    CURRENT_ACCOUNT=""
    ACCOUNTS_NAMES=()
    ACCOUNTS_MAP=()

    [[ -f "$config" ]] || return 0
    
    local line name from
    local section=""

    while IFS= read -r line; do
        line="${line%%#*}"
        [[ -z "${line//[[:space:]]/}" ]] && continue

        if [[ "$line" =~ ^\[(.+)\]$ ]]; then
            section="${BASH_REMATCH[1]}"
            continue
        fi
        [[ "$line" == *=* ]] || continue

        case "$section" in
            using)
                name="${line%%=*}"
                [[ "$name" == "current" ]] && CURRENT_ACCOUNT="${line#*=}"
                ;;
            accounts)
                name="${line%%=*}"
                from="${line#*=}"
                [[ -z "${ACCOUNTS_MAP[$name]:-}" ]] && ACCOUNTS_NAMES+=("$name")
                ACCOUNTS_MAP["$name"]="$from"
                ;;
            *)
                echo "anmail: Found unknown section '[$section]' in config." >&2
                ;;
        esac
    done < "$config"
}
write_accounts_config(){
    local config tmp
    config="$(accounts_file_path)"
    new_tmp tmp
    mkdir -p "$(dirname "$config")"
    
    {
        printf '[using]\n'
        printf 'current=%s\n' "${CURRENT_ACCOUNT:-}"
        printf '[accounts]\n'
        local name
        for name in "${ACCOUNTS_NAMES[@]}"; do
            local from
            from="${ACCOUNTS_MAP[$name]}"
            printf '%s=%s\n' "$name" "$from"
        done
    } > "$tmp"
    mv "$tmp" "$config"
}


# Function
#send
cmd_send(){
    #help
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage_send
        return
    fi

    #header
    if [[ $# -eq 0 ]]; then
        echo "pls: mail send <To> ([Subject])" >&2
        exit 1
    fi
    local TO="$1"
    local SUBJECT="${2:-}"

    new_tmp BODY

    #nvim(or user's EDITOR) body
    if [[ -z "${VISUAL:-}" && -z "${EDITOR}" ]]; then
        echo "anmail: no EDITOR set, using nvim." >&2
    fi
        #just using any editor u want
    local editor="${VISUAL:-${EDITOR:-nvim}}"
    local editor_name
    editor_name="$(basename "$editor")"
    local -a editor_args=()
    case 'editor_name' in
        vim|nvim|gvim|mvim)
            editor_args+=(-c 'set ft=mail')
            ;;
    esac
    "$editor" "${editor_args[@]}" "$BODY"

    #check text
    if ! grep -q '[^[:space:]]' "$BODY"; then
        echo "why send empty" >&2
        exit 1
    fi

    #compose
    {
        printf 'From: %s\n' "$FROM"
        printf 'To: %s\n' "$TO"
        #Subject can be none
        if [[ -n "$SUBJECT" ]]; then
            printf 'Subject: %s\n' "$SUBJECT"
        fi
        printf '\n'
        cat "$BODY"
    } | himalaya message send --account "$ACCOUNT"
    
    rm -f "$BODY" # sometimes, trap will not work 
}

#list
cmd_list(){
    himalaya envelope list --account "$ACCOUNT" "$@"
}

#read
cmd_read(){
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        himalaya message read --help
        return
    fi
    if [[ $# -eq 0 ]] ; then
        echo "pls: tell me what u wanna read."
        echo "anmail: may using 'anmail read <ID>' or try 'anmail read --help"
        exit 1
    fi
    himalaya message read --account "$ACCOUNT" "$@"
}

#set
cmd_set(){
    local interactive=0
    local config
    config="$(accounts_file_path)"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                usage_set
                return
                ;;
            -i|--interactive)
                interactive=1
                shift
                ;;
            *)
                break
                ;;
        esac
    done

    #no args/interactive -> list
    if [[ "${1:-}" == "list" || ( $# -eq 0 && $interactive -eq 0 ) ]]; then
        if [[ -f "$config" ]]; then
            cat "$config"
        else
            echo "anmail: no account in $config" >&2
        fi
        return
    fi

    local name from
    if [[ $interactive -eq 1 ]]; then
        if [[ $# -ge 1 ]]; then
            name="$1"
        else
            read -rp "account name: " name
        fi
        if  [[ -z "$name" ]]; then
            echo "pls: tell me the account name." >&2
            exit 1
        fi
        if [[ $# -ge 2 ]]; then
            from="$2"
        else
            read -rp "from for '$name': " from
        fi
    else
        if [[ $# -ne 2 ]]; then
            echo "anmail: usage: anmail set <name> <from>" >&2
            echo "    e.g. anmail set work '\"Work Name\" <work@company.com>'" >&2
            echo "    or:  anmail set -i [name] [from]" >&2
            exit 1
        fi
        name="$1"
        from="$2"
    fi

    if [[ -z "$name" ]]; then
        if [[ -z "$from" ]]; then
            echo "anmail: name & from can't be empty." >&2
            exit 1
        else
            echo "pls: tell me the account name." >&2
            exit 1 
        fi
    elif [[ -z "$from" ]]; then
        echo "anmail: from can't be empty" >&2
        exit 1
    fi
    if [[ "$name" == "current" ]]; then
        echo "anmail: 'current' is reserved, use 'anmail use' instead" >&2
        exit 1
    fi

    read_accounts_config
    [[ -z "${ACCOUNTS_MAP[$name]:-}" ]] && ACCOUNTS_NAMES+=("$name")
    ACCOUNTS_MAP["$name"]="$from"
    write_accounts_config
    echo "anmail: account '$name' set successfully."
}
cmd_use(){
    local config
    config="$(accounts_file_path)"

    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage_use
        return
    fi

    #no args, show current
    local current
    if [[ $# -eq 0 ]]; then
        if current="$(resolve_account)"; then
            echo "anmail: current account: $current"
        else
            echo "anmail: no accounts configured." >&2
            exit 1
        fi
        return
    fi

    local name="$1"
    if [[ "$name" == "current" ]]; then
        echo "anmail: 'current' is reserved." >&2
        if current="$(resolve_account)"; then
            echo "anmail: current account: $current"
        fi
        exit 1
    fi
    
    read_accounts_config
    if [[ -z "${ACCOUNTS_MAP[$name]:-}" ]]; then
        echo "anmail: unknown account '$name'" >&2
        echo "May: check $config" >&2
        exit 1
    fi
    CURRENT_ACCOUNT="$name"
    write_accounts_config
    echo "anmail: now you're using '$name'."
}

#mainu~
ACCOUNT=""
args=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -a|--account)
            ACCOUNT="$2"
            shift 2
            ;;
        --account=*)
            ACCOUNT="${1#*=}"
            shift
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

cmd="${args[0]:-}"
sub_args=("${args[@]:1}")

# some one, skip the check
case "$cmd" in
    set|use|-h|--help|-v|--version|"")
        :
        ;;
    send|list|read)
        case "${sub_args[0]:-}" in
            -h|--help)# let cmd_* handle sub-help
                : # skip, =~ pass
                ;;
            *)
                if [[ -z "$ACCOUNT" ]]; then
                    ACCOUNT="$(resolve_account)" || {
                        echo "anmail: no accounts configured." >&2
                        echo "May try: anmail set -i" >&2
                        exit 1
                    }
                fi
                
                FROM="$(load_account_from "$ACCOUNT")" || {
                    echo "anmail: unknown account '$ACCOUNT'" >&2
                    echo "May: Check $(accounts_file_path)" >&2
                    exit 1
                }
                ;;
        esac
        ;;
    *)
        echo "anmail: unknown command '$cmd'" >&2
        echo "May try: anmail --help" >&2
        exit 1
        ;;
esac

# cmd
case "$cmd" in
    send)
        cmd_send "${sub_args[@]}"
        ;;
    list)
        cmd_list "${sub_args[@]}"
        ;;
    read)
        cmd_read "${sub_args[@]}"
        ;;
    set)#'|conf|config)'?
        cmd_set "${sub_args[@]}"
        ;;
    use)
        cmd_use "${sub_args[@]}"
        ;;
    -h|--help)
        usage
        ;;
    -v|--version)
        version
        ;;
    "")
        brief
        exit 1
        ;;
    *)
        echo "anmail: unknown command '$cmd'" >&2
        echo "May try: anmail help" >&2
        exit 1
        ;;
esac
